#!/usr/bin/env bash
# Sandbox clipboard shim, installed as `wl-paste` inside the microVM. Claude Code
# shells out to `wl-paste` to read the clipboard, but the VM has no display, so we
# relay the requested arguments to the host's bridge server over the pasta network
# and print the bytes that come back. It exits non-zero when wl-paste would: when the
# host refuses or wl-paste fails there (an empty clipboard, say), and when there is no
# bridge or the launch did not enable clipboard forwarding, so Claude Code proceeds as
# if there were nothing to paste.
port="${CLAUDE_SANDBOX_BRIDGE_PORT:-}"
token="${CLAUDE_SANDBOX_BRIDGE_TOKEN:-}"
[ -n "$port" ] && [ -n "$token" ] || exit 1

# bash's /dev/tcp keeps the connection open until the host has sent everything, so
# large images arrive whole. The reply is a status line, then (after OK) the bytes.
exec 3<>"/dev/tcp/host.containers.internal/${port}" 2>/dev/null || exit 1
printf '%s clipboard\n%s\n' "$token" "$*" >&3
IFS= read -r status <&3 || exit 1
[ "$status" = OK ] || exit 1
cat <&3
