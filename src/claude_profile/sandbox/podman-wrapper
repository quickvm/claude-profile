#!/bin/sh
# Installed as `podman` ahead of /usr/bin/podman on PATH inside the claude-profile
# microVM. Rootless podman can't run here (the nested user namespace can't be mapped
# and native overlay isn't backable on the virtiofs root), so podman must run rootful.
# This wrapper routes callers through the scoped passwordless sudo; an already-root
# caller (e.g. an explicit `sudo podman`, which resolves to /usr/bin/podman via
# secure_path) execs the real binary directly to avoid a second sudo.
#
# It exists so MCP servers configured as `podman run …` (github, buildkite, the
# victoria* servers) launch without rewriting their config. `sudo -E` preserves the
# environment because those servers pass tokens through as `-e VAR` (with the value
# in the environment, not on the command line); a plain sudo would strip them. The
# matching sudoers rule carries the SETENV tag to allow -E.
#
# In an Agent Vault session HTTPS_PROXY points at a proxy that decrypts HTTPS with its
# own CA. podman would pass it into containers and build steps, which don't trust that
# CA, so podman runs without it: containers, builds and pulls go direct, as they do
# outside a session. A command with --http-proxy=true keeps it: that is how an MCP
# server holding a placeholder token asks to be brokered. A `run` or `create` that asks
# also gets the session's CA bundle (SSL_CERT_FILE) at /run/agent-vault/ca-bundle.pem,
# with the CA variables pointing there, so its HTTPS trusts the proxy. They go on the
# command line because an image's own ENV (SSL_CERT_FILE, say) beats containers.conf.
# The host launch's podman shim does the same (claude_profile._write_podman_shim).
keep_proxy=
for arg do
	[ "$arg" = --http-proxy=true ] && keep_proxy=1
done
if [ -z "$keep_proxy" ]; then
	unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy
elif [ -n "$SSL_CERT_FILE" ]; then
	case $1 in
	run | create)
		subcommand=$1
		shift
		ca=/run/agent-vault/ca-bundle.pem
		set -- "$subcommand" --volume "$SSL_CERT_FILE:$ca:ro,z" \
			--env "SSL_CERT_FILE=$ca" \
			--env "NODE_EXTRA_CA_CERTS=$ca" \
			--env "REQUESTS_CA_BUNDLE=$ca" \
			--env "CURL_CA_BUNDLE=$ca" \
			--env "GIT_SSL_CAINFO=$ca" \
			--env "DENO_CERT=$ca" \
			"$@"
		;;
	esac
fi
if [ "$(id -u)" = 0 ]; then
	exec /usr/bin/podman "$@"
fi
exec sudo -E /usr/bin/podman "$@"
