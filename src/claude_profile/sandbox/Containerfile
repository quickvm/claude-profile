# Sandbox image for `claude-profile` microVM mode (podman + krun runtime).
# Build with: claude-profile build
# Extend this file for project-specific tooling, then rebuild.
FROM fedora:44

RUN dnf install -y \
      git gh ripgrep fd-find jq yq less ca-certificates openssh-clients socat \
      sudo openssl make patch diffutils ShellCheck trash-cli butane \
      podman fuse-overlayfs passt \
      nodejs22 nodejs22-npm python3-pyyaml python3-jinja2 \
    && dnf clean all

# Infisical CLI (secrets management), from Infisical's own package host — Cloudsmith
# is being retired. The setup script configures the dnf repo; the binary is a static
# Go executable. claude-profile forwards your infisical login token into the VM via
# env (CLAUDE_PROFILE_SANDBOX_INFISICAL); this provides the CLI that consumes it.
RUN curl -1sLf https://artifacts-cli.infisical.com/setup.rpm.sh | bash \
    && dnf install -y infisical \
    && dnf clean all

# Passwordless sudo scoped to the package manager plus podman: the agent can install
# missing system packages and run nested containers, but cannot sudo-write into the
# bind mounts. Podman runs rootful because the guest kernel sees uid 0 as real root —
# rootless podman can't unpack layers in the nested user namespace. The podman rule
# carries SETENV so the `podman` wrapper's `sudo -E` can preserve pass-through env
# (MCP servers pass tokens as `-e VAR` with the value taken from the environment).
RUN useradd -m -u 1000 -U appuser \
    && printf '%s\n' \
       'appuser ALL=(root) NOPASSWD: /usr/bin/dnf, /usr/bin/dnf5' \
       'appuser ALL=(root) NOPASSWD:SETENV: /usr/bin/podman' \
       > /etc/sudoers.d/appuser \
    && chmod 0440 /etc/sudoers.d/appuser

# Rootful podman stores images with fuse-overlayfs: the microVM's virtiofs root can't
# back a native overlay ("upper fs missing required features"), and vfs copies every
# layer. fuse-overlayfs gives real layered storage on any backing filesystem.
RUN mkdir -p /etc/containers \
    && printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
       > /etc/containers/storage.conf

# Route `podman` through rootful sudo inside the VM (see the wrapper script header).
# Installed at /usr/local/bin (ahead of /usr/bin on PATH) so bare `podman` works —
# including the `podman run …` MCP servers (github, buildkite, victoria*) — without
# rewriting their config for the sandbox.
COPY podman-wrapper /usr/local/bin/podman
RUN chmod +x /usr/local/bin/podman

# Install uv, the native claude binary, ty, and pulumi as the unprivileged user.
# uv/claude/ty land in ~/.local/bin; pulumi installs to ~/.pulumi/bin (both on PATH
# below). claude-profile forwards your Pulumi Cloud token via CLAUDE_PROFILE_SANDBOX_PULUMI.
USER appuser
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && curl -fsSL https://claude.ai/install.sh | bash \
    && /home/appuser/.local/bin/uv tool install ty \
    && curl -fsSL https://get.pulumi.com | sh
USER root

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Clipboard shim: Claude Code reads pasted images by shelling out to `wl-paste`.
# The VM has no display, so this shim relays the request to the host clipboard
# bridge (see claude_profile._start_clipboard_host_bridge). It is inert unless
# CLAUDE_SANDBOX_CLIPBOARD_PORT is set, so it is harmless when clipboard
# forwarding is disabled.
COPY wl-paste /usr/local/bin/wl-paste
RUN chmod +x /usr/local/bin/wl-paste

ENV PATH="/home/appuser/.local/bin:/home/appuser/.pulumi/bin:$PATH"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]
