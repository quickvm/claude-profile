# Sandbox image for `claude-profile` microVM mode (podman + krun runtime).
# Build with: claude-profile build
# Extend this file for project-specific tooling, then rebuild.
# Tool versions and the base image are pinned; bump them deliberately.
FROM registry.fedoraproject.org/fedora:44@sha256:b0b2ac1c4a682dea428ae05a0065824178ad951c304c3ac15c29daa8335e0599

RUN dnf install -y \
      git gh ripgrep fd-find jq yq less ca-certificates openssh-clients socat \
      sudo openssl make patch diffutils ShellCheck trash-cli butane \
      podman fuse-overlayfs passt \
      nodejs22 nodejs22-npm python3-pyyaml python3-jinja2 \
    && dnf clean all

# Infisical CLI (secrets management), from Infisical's own package host — Cloudsmith
# is being retired. The setup script configures the dnf repo; the binary is a static
# Go executable. claude-profile forwards your infisical login token into the VM via
# env (CLAUDE_PROFILE_SANDBOX_INFISICAL); this provides the CLI that consumes it.
RUN curl -1sLf https://artifacts-cli.infisical.com/setup.rpm.sh | bash \
    && dnf install -y infisical-0.43.138 \
    && dnf clean all

# Buildkite CLI (bk) — no dnf repo exists, so install the release RPM. It authenticates
# from the BUILDKITE_API_TOKEN env var, which you forward with
# CLAUDE_PROFILE_SANDBOX_FORWARD_ENV (the same token the buildkite MCP uses).
RUN curl -fsSL -o /tmp/bk.rpm \
      https://github.com/buildkite/cli/releases/download/v3.59.1/bk_3.59.1_linux_amd64.rpm \
    && echo 'e58e1982b7d4458bf80765d8296a81ec9c6e34e5718b3b0a45cc79327a6aa266  /tmp/bk.rpm' \
      | sha256sum -c - \
    && dnf install -y /tmp/bk.rpm \
    && rm -f /tmp/bk.rpm \
    && dnf clean all

# Passwordless sudo for the package manager and podman, so the agent can install
# missing system packages and run nested containers. Either one amounts to root inside
# the VM: the VM is the isolation boundary, not these rules. Podman runs rootful
# because the guest kernel sees uid 0 as real root —
# rootless podman can't unpack layers in the nested user namespace. The podman rule
# carries SETENV so the `podman` wrapper's `sudo -E` can preserve pass-through env
# (MCP servers pass tokens as `-e VAR` with the value taken from the environment).
# The wrapper's own path is allowed too: sudo's secure_path resolves `sudo podman` to it,
# and it just execs /usr/bin/podman when already root.
RUN useradd -m -u 1000 -U appuser \
    && printf '%s\n' \
       'appuser ALL=(root) NOPASSWD: /usr/bin/dnf, /usr/bin/dnf5' \
       'appuser ALL=(root) NOPASSWD:SETENV: /usr/bin/podman, /usr/local/bin/podman' \
       > /etc/sudoers.d/appuser \
    && chmod 0440 /etc/sudoers.d/appuser

# Rootful podman stores images with fuse-overlayfs: the microVM's virtiofs root can't
# back a native overlay ("upper fs missing required features"), and vfs copies every
# layer. fuse-overlayfs gives real layered storage on any backing filesystem.
RUN mkdir -p /etc/containers \
    && printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
       > /etc/containers/storage.conf

# Route `podman` through rootful sudo inside the VM (see the wrapper script header).
# Installed at /usr/local/bin (ahead of /usr/bin on PATH) so bare `podman` works —
# including the `podman run …` MCP servers (github, buildkite, victoria*) — without
# rewriting their config for the sandbox.
COPY podman-wrapper /usr/local/bin/podman
RUN chmod +x /usr/local/bin/podman

# Install uv, the native claude binary, ty, and pulumi as the unprivileged user.
# uv/claude/ty land in ~/.local/bin; pulumi installs to ~/.pulumi/bin (both on PATH
# below). claude-profile forwards your Pulumi Cloud token via CLAUDE_PROFILE_SANDBOX_PULUMI.
# Launches normally run the host's own claude (mounted at /opt/claude-host/claude, see
# claude_profile._sandbox_claude_binary), so this pinned copy is only the fallback for
# hosts whose claude did not come from the native installer.
USER appuser
RUN curl -LsSf https://astral.sh/uv/0.12.21/install.sh | sh \
    && curl -fsSL https://claude.ai/install.sh | bash -s 2.1.295 \
    && /home/appuser/.local/bin/uv tool install ty==0.0.84 \
    && curl -fsSL https://get.pulumi.com | sh -s -- --version 3.267.0
USER root

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Connects each client of a forwarded socket to the host's bridge server with this
# launch's token (see entrypoint.sh and claude_profile.bridges).
COPY bridge-connect /usr/local/libexec/claude-sandbox/bridge-connect
RUN chmod +x /usr/local/libexec/claude-sandbox/bridge-connect

# Clipboard shim: Claude Code reads pasted images by shelling out to `wl-paste`.
# The VM has no display, so this shim relays the request to the bridge server's
# clipboard service (see claude_profile.bridges). It is inert unless the launch
# enabled clipboard forwarding.
COPY wl-paste /usr/local/bin/wl-paste
RUN chmod +x /usr/local/bin/wl-paste

# Browser-open shim: Claude Code's Chrome integration detects a browser via
# `which google-chrome` and opens its extension connect/reconnect page by running
# `google-chrome <url>`. The VM has no browser, so this shim relays the URL to the
# bridge server's open service (see claude_profile.bridges), which opens it in the
# real Chrome to wake the extension. Inert unless the launch enabled Chrome forwarding.
COPY google-chrome /usr/local/bin/google-chrome
RUN chmod +x /usr/local/bin/google-chrome \
    && ln -sf google-chrome /usr/local/bin/google-chrome-stable

ENV PATH="/home/appuser/.local/bin:/home/appuser/.pulumi/bin:$PATH"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]
