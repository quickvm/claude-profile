# Sandbox image for `claude-profile` microVM mode (podman + krun runtime).
# Build with: claude-profile build
# Extend this file for project-specific tooling, then rebuild.
FROM fedora:44

RUN dnf install -y git ripgrep fd-find less ca-certificates openssh-clients socat && dnf clean all

RUN useradd -m -u 1000 -U appuser

# Install the native claude binary as the unprivileged user (lands in ~/.local/bin).
USER appuser
RUN curl -fsSL https://claude.ai/install.sh | bash
USER root

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH="/home/appuser/.local/bin:$PATH"
ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]
