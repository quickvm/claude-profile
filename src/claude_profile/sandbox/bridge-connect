#!/bin/bash
# Run by the entrypoint's socat for each client of a forwarded socket, with the client on
# stdin/stdout. Opens the host's bridge server over pasta, sends this launch's token and
# the service name ($1) it is for, then relays both ways. Whatever this prints lands in
# claude's TUI, so it stays quiet: -d0 keeps socat to errors, dropping the warning it logs
# each time the entrypoint's socat ends a finished connection with SIGTERM.
exec 3<>"/dev/tcp/host.containers.internal/${CLAUDE_SANDBOX_BRIDGE_PORT}" 2>/dev/null || exit 1
printf '%s %s\n' "$CLAUDE_SANDBOX_BRIDGE_TOKEN" "$1" >&3
exec socat -d0 - FD:3
